        },
        {
          "ruleId": "SENT-DC-001",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Internal package name is exposed on a public registry: acme-demo-reports scored 30 (MEDIUM). internal name is registered on the public registry and is not declared as owned by you"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable-demo/requirements.txt",
                  "uriBaseId": "%SRCROOT%"
